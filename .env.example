NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org

# Pin the only contract your agent is allowed to call
NEAR_ALLOWED_CONTRACT_ID=your-contract.testnet
NEAR_ALLOWED_METHODS=deposit

# Testnet-only signer configuration. Never commit a real private key.
NEAR_SIGNER_ACCOUNT_ID=your-agent.testnet
NEAR_SIGNER_PUBLIC_KEY=ed25519:your-public-key
NEAR_SIGNER_PRIVATE_KEY=ed25519:YOUR_TESTNET_PRIVATE_KEY



# Agent API authentication
AGENTSHIELD_API_KEY=replace-with-a-unique-agent-key

# Human reviewer authentication (must be different)
AGENTSHIELD_REVIEWER_API_KEY=replace-with-a-unique-reviewer-key
